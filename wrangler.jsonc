{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chorusdbjp-api",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-07-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chorusdbjp",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
